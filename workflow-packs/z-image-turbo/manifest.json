{
  "id": "z-image-turbo",
  "name": "Z-Image Turbo",
  "type": "text-to-image",
  "description": "Fast general-purpose text-to-image starter workflow using stock ComfyUI nodes.",
  "tagline": "Fast everyday image generation with a simple stock-ComfyUI workflow.",
  "highlights": ["Text to image", "Fast", "Stock nodes"],
  "recommended": true,
  "thumbnail": "/static/curated-thumbnails/z-image-turbo.jpg",
  "thumbnailAlt": "Example image generated with Z-Image Turbo",
  "workflowFile": "image_z_image_turbo.json",
  "tool": {
    "id": "z-image",
    "name": "Realistic Generation",
    "workflowFile": "image_z_image_turbo.json",
    "nodeMapping": {
      "prompt": {"nodeId": "67", "field": "text"},
      "width": {"nodeId": "68", "field": "width"},
      "height": {"nodeId": "68", "field": "height"},
      "seed": {"nodeId": "70", "field": "seed", "generateRandom": true}
    }
  },
  "models": [
    {
      "id": "diffusion",
      "folder": "diffusion_models",
      "bf16MinVramGb": 24,
      "variants": [
        {
          "precision": "int8",
          "filename": "z_image_turbo_int8_convrot.safetensors",
          "url": "https://huggingface.co/Comfy-Org/z_image_turbo/resolve/main/split_files/diffusion_models/z_image_turbo_int8_convrot.safetensors",
          "requiresInt8ConvRot": true
        },
        {
          "precision": "bf16",
          "filename": "z_image_turbo_bf16.safetensors",
          "url": "https://huggingface.co/Comfy-Org/z_image_turbo/resolve/main/split_files/diffusion_models/z_image_turbo_bf16.safetensors"
        }
      ]
    },
    {
      "id": "text_encoder",
      "folder": "text_encoders",
      "bf16MinVramGb": 24,
      "variants": [
        {
          "precision": "fp8",
          "filename": "qwen_3_4b_fp8_mixed.safetensors",
          "url": "https://huggingface.co/Comfy-Org/z_image_turbo/resolve/main/split_files/text_encoders/qwen_3_4b_fp8_mixed.safetensors"
        },
        {
          "precision": "bf16",
          "filename": "qwen_3_4b.safetensors",
          "url": "https://huggingface.co/Comfy-Org/z_image_turbo/resolve/main/split_files/text_encoders/qwen_3_4b.safetensors"
        }
      ]
    },
    {
      "id": "vae",
      "folder": "vae",
      "precision": "bf16",
      "filename": "ae.safetensors",
      "url": "https://huggingface.co/Comfy-Org/z_image_turbo/resolve/main/split_files/vae/ae.safetensors"
    }
  ],
  "bindings": [
    {"modelId": "diffusion", "nodeId": "66", "field": "unet_name"},
    {"modelId": "text_encoder", "nodeId": "62", "field": "clip_name"},
    {"modelId": "vae", "nodeId": "63", "field": "vae_name"}
  ]
}
